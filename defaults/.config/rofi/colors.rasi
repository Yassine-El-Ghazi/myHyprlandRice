* {
    background: rgba(255, 255, 255, 0.7);
    primary: #246488;
    primary-fixed: #c8e6ff;
    primary-fixed-dim: #94cdf6;
    on-primary: #ffffff;
    on-primary-fixed: #001e2e;
    on-primary-fixed-variant: #004c6d;
    primary-container: #c8e6ff;
    on-primary-container: #001e2e;
    secondary: #4f606e;
    secondary-fixed: #d2e5f5;
    secondary-fixed-dim: #b7c9d8;
    on-secondary: #ffffff;
    on-secondary-fixed: #0b1d29;
    on-secondary-fixed-variant: #384956;
    secondary-container: #d2e5f5;
    on-secondary-container: #0b1d29;
    tertiary: #63597c;
    tertiary-fixed: #e9ddff;
    tertiary-fixed-dim: #cdc0e9;
    on-tertiary: #ffffff;
    on-tertiary-fixed: #1f1635;
    on-tertiary-fixed-variant: #4b4163;
    tertiary-container: #e9ddff;
    on-tertiary-container: #1f1635;
    error: #ba1a1a;
    on-error: #ffffff;
    error-container: #ffdad6;
    on-error-container: #410002;
    surface: #f6fafe;
    on-surface: #181c20;
    on-surface-variant: #41484d;
    outline: #71787e;
    outline-variant: #c1c7ce;
    shadow: #000000;
    scrim: #000000;
    inverse-surface: #2d3135;
    inverse-on-surface: #eef1f6;
    inverse-primary: #94cdf6;
    surface-dim: #d7dadf;
    surface-bright: #f6fafe;
    surface-container-lowest: #ffffff;
    surface-container-low: #f1f4f9;
    surface-container: #ebeef3;
    surface-container-high: #e5e8ed;
    surface-container-highest: #dfe3e7;
}
