#!/usr/bin/env bash
set -Eeuo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
if [[ ${1:-} == -j ]]; then
    shift
fi
case ${1:-} in
    monitors)
        command cat -- "${TEST_HYPRCTL_FIXTURE:-$SCRIPT_DIR/../fixtures/hypr-monitors.json}"
        ;;
    eval|notify)
        printf '%s\n' "$*" >> "${TEST_HYPRCTL_LOG:?}"
        ;;
    *)
        printf 'Unexpected fake hyprctl call: %s\n' "$*" >&2
        exit 2
        ;;
esac
