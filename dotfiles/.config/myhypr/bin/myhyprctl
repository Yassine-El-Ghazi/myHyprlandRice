#!/usr/bin/env bash
set -Eeuo pipefail

SCRIPT_PATH=$(readlink -f -- "${BASH_SOURCE[0]}")
REPO_ROOT=$(cd -- "$(dirname -- "$SCRIPT_PATH")/../../../.." && pwd -P)
CONFIG_ROOT="${XDG_CONFIG_HOME:-$HOME/.config}"
QUICKSHELL_CONFIG="$CONFIG_ROOT/quickshell/shell.qml"

usage() {
    cat <<'EOF'
Usage: myhyprctl COMMAND

Desktop panels:
  welcome | settings | calendar | sidebar | power

Desktop actions:
  wallpaper | theme | reload | doctor | docs

Maintenance:
  update | update-system | update-plan | update-status [ID] | recover ID
EOF
}

usage_error() {
    printf 'Invalid arguments for command: %s\n' "${1:-}" >&2
    usage >&2
    exit 2
}

toggle_panel() {
    local target=$1
    if qs ipc call "$target" toggle >/dev/null 2>&1; then
        return 0
    fi

    quickshell -p "$QUICKSHELL_CONFIG" >/dev/null 2>&1 &
    disown
    for _attempt in {1..20}; do
        sleep 0.1
        qs ipc call "$target" toggle >/dev/null 2>&1 && return 0
    done
    printf 'Unable to contact the MyHypr Quickshell service.\n' >&2
    return 1
}

case ${1:-} in
    welcome|settings|calendar|sidebar|power)
        toggle_panel "$1"
        ;;
    wallpaper)
        exec waypaper --backend awww
        ;;
    theme)
        exec "$CONFIG_ROOT/myhypr/themes/themes.sh"
        ;;
    reload)
        hyprctl reload
        hyprctl configerrors
        ;;
    doctor)
        [[ $# -eq 1 ]] || usage_error "$1"
        exec "$REPO_ROOT/scripts/doctor.sh" --profile desktop
        ;;
    update)
        [[ $# -eq 1 ]] || usage_error "$1"
        exec "$REPO_ROOT/scripts/maintenance.sh" apply dotfiles \
            --profile desktop
        ;;
    update-system)
        [[ $# -eq 1 ]] || usage_error "$1"
        exec "$REPO_ROOT/scripts/update-system.sh"
        ;;
    update-plan)
        [[ $# -eq 1 ]] || usage_error "$1"
        exec "$REPO_ROOT/scripts/maintenance.sh" plan dotfiles \
            --profile desktop
        ;;
    update-status)
        [[ $# -le 2 ]] || usage_error "$1"
        if [[ $# -eq 2 ]]; then
            exec "$REPO_ROOT/scripts/maintenance.sh" status "$2"
        fi
        exec "$REPO_ROOT/scripts/maintenance.sh" status
        ;;
    recover)
        [[ $# -eq 2 ]] || usage_error "$1"
        exec "$REPO_ROOT/scripts/maintenance.sh" recover "$2"
        ;;
    docs)
        exec xdg-open "$REPO_ROOT/README.md"
        ;;
    -h|--help|help|'')
        usage
        ;;
    *)
        printf 'Unknown command: %s\n' "$1" >&2
        usage >&2
        exit 2
        ;;
esac
