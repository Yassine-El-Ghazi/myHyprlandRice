[Unit]
Description=Walker application launcher service
Documentation=https://github.com/abenz1267/walker
PartOf=myhypr-session.target
After=graphical-session-pre.target elephant.service
Requires=elephant.service

[Service]
Type=dbus
BusName=dev.benz.walker
ExecStart=/usr/bin/walker --gapplication-service
Restart=on-failure
RestartSec=1s
