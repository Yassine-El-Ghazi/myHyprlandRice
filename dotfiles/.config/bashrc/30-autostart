# The 'finder' command (Fuzzy Finder)
finder() {
    # Run the script and capture the result
    local result
    # Keep fd 3 attached to the terminal so a selected file can open an
    # interactive editor while stdout carries the directory-selection result.
    result=$("$HOME/.config/myhypr/bin/myhypr-finder.sh" 3>&1)

    # Check if the script told us to CD
    if [[ "$result" == TYPE_DIR:* ]]; then
        local target_dir="${result#TYPE_DIR:}"
        cd "$target_dir" && ls
    fi
}

# -----------------------------------------------------
# Fastfetch
# -----------------------------------------------------
if [[ $- == *i* && -t 1 ]] && command -v fastfetch >/dev/null 2>&1; then
    fastfetch
fi
