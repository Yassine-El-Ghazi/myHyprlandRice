#!/usr/bin/env bash
set -Eeuo pipefail
#    _____    __                 __
#   / __(_)__/ /__ ___  ___ ____/ /
#  _\ \/ / _  / -_) _ \/ _ `/ _  / 
# /___/_/\_,_/\__/ .__/\_,_/\_,_/  
#               /_/                
# Main Script

# --- Configuration ---
WINDOW_CLASS="dotfiles-sidepad"
HIDDEN_LEFT_GAP=10
VISIBLE_LEFT_GAP=10
TARGET_WIDTH=700
TARGET_WIDTH_MAX=1000
TOP_GAP=100
BOTTOM_GAP=100

# --- Script Variables ---
HIDE_REQUESTED=0
INIT_REQUESTED=0
declare -a INIT_COMMAND=()

# --- Help Function ---
show_help() {
    echo "Usage: $0 [options]"
    echo "Please make sure that you're using the class only once."
    echo "The window must be in floating mode."
    echo ""
    echo "Options:"
    echo "  --class <name>         Override the window class (Default: $WINDOW_CLASS)"
    echo "  --hidden-gap <px>      Override the hidden left gap (Default: $HIDDEN_LEFT_GAP)"
    echo "  --visible-gap <px>     Override the visible left gap (Default: $VISIBLE_LEFT_GAP)"
    echo "  --width <px>           Override the target width (Default: $TARGET_WIDTH)"
    echo "  --width-max <px>       Override the maximum target width (Default: $TARGET_WIDTH_MAX)"
    echo "  --top-gap <px>         Override the top gap (Default: $TOP_GAP)"
    echo "  --bottom-gap <px>      Override the bottom gap (Default: $BOTTOM_GAP)"
    echo "  --init -- COMMAND...   Launch and initially hide a sidepad app."
    echo "  --hide                 Force the window to the hidden state."
    echo "  --kill                 Kills the running app with WINDOW_CLASS."
    echo "  --test                 Test for running app with WINDOW_CLASS."
    echo "  -h, --help             Display this help and exit"
    exit 0
}

test_sidepad() {
    if ! hyprctl -j clients | jq -e --arg class "$WINDOW_CLASS" '.[] | select(.class == $class)' > /dev/null; then
        echo "1"
        return 1
    else
        echo "0"
        return 0
    fi
}

init_sidepad() {
    local -a command=("$@")

    ((${#command[@]})) || {
        printf 'The --init option requires an application command.\n' >&2
        return 2
    }
    # Check if the window already exists, if not launch it
    if ! hyprctl -j clients | jq -e --arg class "$WINDOW_CLASS" '.[] | select(.class == $class)' > /dev/null; then
        if [[ "$WINDOW_CLASS" == "dotfiles-sidepad" ]]; then
            "${command[@]}" --class "$WINDOW_CLASS" &
        else
            "${command[@]}" &
        fi
        # Wait for the window to appear, with a timeout
        for _attempt in {1..50}; do # ~5 seconds timeout
            if hyprctl -j clients | jq -e --arg class "$WINDOW_CLASS" '.[] | select(.class == $class)' > /dev/null; then
                break
            fi
            sleep 0.1
        done
    fi
}

kill_sidepad() {
    local pid
    local killed=0
    local -a window_pids=()

    mapfile -t window_pids < <(
        hyprctl -j clients | jq -r --arg class "$WINDOW_CLASS" \
            '.[] | select(.class == $class) | .pid | select(. > 0)'
    )
    for pid in "${window_pids[@]}"; do
        [[ $pid =~ ^[0-9]+$ ]] || continue
        printf "Killing process with PID %s for window class '%s'.\n" "$pid" "$WINDOW_CLASS"
        kill "$pid"
        killed=1
    done
    if [[ $killed -eq 0 ]]; then
        echo "Error: Window with class '$WINDOW_CLASS' not found or has no valid PID." >&2
    fi
    sleep 1
    exit 0
}

# --- Parse Command-line Options ---
while [[ $# -gt 0 ]]; do
    key="$1"
    case $key in
        --class)
            (($# >= 2)) || { printf '%s requires a value.\n' "$1" >&2; exit 2; }
            WINDOW_CLASS="$2"
            shift 2
        ;;

        --hidden-gap)
            (($# >= 2)) || { printf '%s requires a value.\n' "$1" >&2; exit 2; }
            HIDDEN_LEFT_GAP="$2"
            shift 2
        ;;

        --visible-gap)
            (($# >= 2)) || { printf '%s requires a value.\n' "$1" >&2; exit 2; }
            VISIBLE_LEFT_GAP="$2"
            shift 2
        ;;

        --width)
            (($# >= 2)) || { printf '%s requires a value.\n' "$1" >&2; exit 2; }
            TARGET_WIDTH="$2"
            shift 2
        ;;

        --width-max)
            (($# >= 2)) || { printf '%s requires a value.\n' "$1" >&2; exit 2; }
            TARGET_WIDTH_MAX="$2"
            shift 2
        ;;

        --top-gap)
            (($# >= 2)) || { printf '%s requires a value.\n' "$1" >&2; exit 2; }
            TOP_GAP="$2"
            shift 2
        ;;

        --bottom-gap)
            (($# >= 2)) || { printf '%s requires a value.\n' "$1" >&2; exit 2; }
            BOTTOM_GAP="$2"
            shift 2
        ;;

        --hide)
            HIDE_REQUESTED=1
            shift
        ;;

        --test)
            test_sidepad
            exit 0
        ;;

        --kill)
            kill_sidepad
        ;;

        --init)
            shift
            [[ ${1:-} == -- ]] && shift
            (($#)) || { printf '%s requires a command.\n' '--init' >&2; exit 2; }
            INIT_COMMAND=("$@")
            INIT_REQUESTED=1
            HIDE_REQUESTED=1
            break
        ;;

        -h|--help)
            show_help
        ;;

        *)
            printf 'Unknown sidepad option: %s\n' "$1" >&2
            exit 2
        ;;
    esac
done

for numeric_value in \
    "$HIDDEN_LEFT_GAP" "$VISIBLE_LEFT_GAP" "$TARGET_WIDTH" \
    "$TARGET_WIDTH_MAX" "$TOP_GAP" "$BOTTOM_GAP"; do
    [[ $numeric_value =~ ^-?[0-9]+$ ]] || {
        printf 'Sidepad dimensions must be integers.\n' >&2
        exit 2
    }
done

if [[ $INIT_REQUESTED -eq 1 ]]; then
    init_sidepad "${INIT_COMMAND[@]}"
fi

# --- Get Window and Monitor Info ---
WINDOW_INFO=$(hyprctl -j clients | jq --arg class "$WINDOW_CLASS" '.[] | select(.class == $class)')
MONITOR_INFO=$(hyprctl -j monitors | jq -r '.[] | select(.focused == true)')

if [ -z "$WINDOW_INFO" ]; then
    echo "Error: Window with class '$WINDOW_CLASS' not found. Is the window open?"
    exit 1
fi

WINDOW_ADDRESS=$(jq -r '.address' <<< "$WINDOW_INFO")
WINDOW_WIDTH=$(jq -r '.size[0]' <<< "$WINDOW_INFO")
WINDOW_HEIGHT=$(jq -r '.size[1]' <<< "$WINDOW_INFO")
WINDOW_X=$(jq -r '.at[0]' <<< "$WINDOW_INFO")
WINDOW_Y=$(jq -r '.at[1]' <<< "$WINDOW_INFO")
MONITOR_HEIGHT=$(jq -r '.height' <<< "$MONITOR_INFO")

[[ $WINDOW_ADDRESS =~ ^0x[0-9A-Fa-f]+$ ]] || {
    printf 'Hyprland returned an invalid window address.\n' >&2
    exit 1
}
for numeric_value in "$WINDOW_WIDTH" "$WINDOW_HEIGHT" "$WINDOW_X" "$WINDOW_Y" "$MONITOR_HEIGHT"; do
    [[ $numeric_value =~ ^-?[0-9]+$ ]] || {
        printf 'Hyprland returned invalid window geometry.\n' >&2
        exit 1
    }
done

apply_geometry() {
    local width_delta=$1
    local height_delta=$2
    local x_delta=$3
    local y_delta=$4

    hyprctl dispatch "hl.dsp.window.resize({ x = $width_delta, y = $height_delta, relative = true, window = 'address:$WINDOW_ADDRESS' })"
    hyprctl dispatch "hl.dsp.window.move({ x = $x_delta, y = $y_delta, relative = true, window = 'address:$WINDOW_ADDRESS' })"
}

# --- Main Logic ---

# Case 1: --hide flag is used, unconditionally hide the window.
if [[ "$HIDE_REQUESTED" -eq 1 ]]; then
    if (( WINDOW_X >= 0 )); then # Only act if it is not already hidden
        echo "--- Hiding window (--hide) ---"
        PIXELS_TO_MOVE_X=$(( (WINDOW_X * -1) - TARGET_WIDTH + HIDDEN_LEFT_GAP ))
        WIDTH_CHANGE=$(( TARGET_WIDTH - WINDOW_WIDTH ))
        PIXELS_TO_MOVE_Y=$(( TOP_GAP - WINDOW_Y ))
        TARGET_HEIGHT=$(( MONITOR_HEIGHT - TOP_GAP - BOTTOM_GAP ))
        HEIGHT_CHANGE=$(( TARGET_HEIGHT - WINDOW_HEIGHT ))

        apply_geometry "$WIDTH_CHANGE" "$HEIGHT_CHANGE" "$PIXELS_TO_MOVE_X" "$PIXELS_TO_MOVE_Y"
        echo "Operation completed."
    else
        echo "Window is already hidden."
    fi
    exit 0
fi

# Case 2: Window is hidden, so show it.
if (( WINDOW_X < 0 )); then
    echo "--- Showing window ---"
    PIXELS_TO_MOVE_X=$(( VISIBLE_LEFT_GAP - WINDOW_X ))
    WIDTH_CHANGE=$(( TARGET_WIDTH - WINDOW_WIDTH ))
    PIXELS_TO_MOVE_Y=$(( TOP_GAP - WINDOW_Y ))
    TARGET_HEIGHT=$(( MONITOR_HEIGHT - TOP_GAP - BOTTOM_GAP ))
    HEIGHT_CHANGE=$(( TARGET_HEIGHT - WINDOW_HEIGHT ))

    apply_geometry "$WIDTH_CHANGE" "$HEIGHT_CHANGE" "$PIXELS_TO_MOVE_X" "$PIXELS_TO_MOVE_Y"
    echo "Operation completed."

# Case 3: Window is visible, so toggle its width and correct its position.
else
    # Ensure vertical position and height are correct
    PIXELS_TO_MOVE_Y=$(( TOP_GAP - WINDOW_Y ))
    TARGET_HEIGHT=$(( MONITOR_HEIGHT - TOP_GAP - BOTTOM_GAP ))
    HEIGHT_CHANGE=$(( TARGET_HEIGHT - WINDOW_HEIGHT ))
    
    # Don't move horizontally
    PIXELS_TO_MOVE_X=0

    # Calculate width change
    if (( WINDOW_WIDTH == TARGET_WIDTH )); then
        echo "--- Expanding width to max ---"
        WIDTH_CHANGE=$(( TARGET_WIDTH_MAX - WINDOW_WIDTH ))
    else
        echo "--- Shrinking width to default ---"
        WIDTH_CHANGE=$(( TARGET_WIDTH - WINDOW_WIDTH ))
    fi

    apply_geometry "$WIDTH_CHANGE" "$HEIGHT_CHANGE" "$PIXELS_TO_MOVE_X" "$PIXELS_TO_MOVE_Y"
    echo "Operation completed."
fi
