# -----------------------------------------------------
# Secret / sensitive files
# -----------------------------------------------------
**/secrets/
**/*.secret
**/*.key
**/*.pem
**/*.p12
**/*.pfx
**/*.crt
**/*.csr
**/*.asc
**/*.kdbx
**/*credentials*
**/*credential*
**/*token*
**/*private*
**/.config/github-copilot/
**/.bashrc_custom
**/.zshrc_custom
.env
.env.*
!.env.example
**/.env
**/.env.*
!**/.env.example
**/*.env

# -----------------------------------------------------
# Shell / Fish / MyHypr variables
# -----------------------------------------------------
**/fish/fish_variables
**/fish/generated_completions/
**/myhypr/bin/*.sh~
**/myhypr/listeners/*.sh~
**/myhypr/scripts/*.sh~
**/myhypr/settings/*.sh~
**/myhypr/wallpapers/*.cache
**/myhypr/wallpapers/*.tmp

# -----------------------------------------------------
# Backup / temporary editor files
# -----------------------------------------------------
**/*~
**/*.bak
**/*.backup
**/*.orig
**/*.rej
**/*.swp
**/*.swo
**/*.tmp
**/*.temp
**/.DS_Store
**/Thumbs.db

# -----------------------------------------------------
# IDE / editor configs
# -----------------------------------------------------
**/.vscode/
**/.idea/
**/tags

# -----------------------------------------------------
# SSH / GPG keys
# -----------------------------------------------------
**/.ssh/
**/.ssh/id_*
**/.gnupg/

# -----------------------------------------------------
# System / OS configs
# -----------------------------------------------------
**/.Xresources~
**/.gtkrc-2.0~

# -----------------------------------------------------
# Optional: caches / local runtime files
# -----------------------------------------------------
**/.cache/
**/Cache/
**/cache/
**/.local/state/
/dotfiles/.config/waypaper/config.ini
**/__pycache__/
**/*.py[cod]

# Host-generated display layout and private Hyprland overrides
/dotfiles/.config/hypr/local.lua
/dotfiles/.config/hypr/monitors.conf
/dotfiles/.config/hypr/monitors.lua
/dotfiles/.config/hypr/workspaces.conf
/dotfiles/.config/hypr/workspaces.lua

# Matugen and application-generated runtime output (defaults live in defaults/)
/dotfiles/.config/gtk-3.0/colors.css
/dotfiles/.config/gtk-4.0/colors.css
/dotfiles/.config/hypr/colors.conf
/dotfiles/.config/hypr/colors.lua
/dotfiles/.config/kitty/colors-matugen.conf
/dotfiles/.config/myhypr/colors/onsurface
/dotfiles/.config/myhypr/colors/primary
/dotfiles/.config/myhypr/colors/secondary
/dotfiles/.config/nwg-dock-hyprland/colors.css
/dotfiles/.config/rofi/colors.rasi
/dotfiles/.config/swaync/colors.css
/dotfiles/.config/walker/colors.css
/dotfiles/.config/waybar/colors.css
/dotfiles/.config/wlogout/colors.css

# Isolated local development worktrees
/.worktrees/
