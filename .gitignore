# -----------------------------------------------------
# Secret / sensitive files
# -----------------------------------------------------
**/secrets/
**/*.secret
**/*.key
**/*.pem
**/*.p12
**/*.pfx
**/*.crt
**/*.csr
**/*.asc
**/*.kdbx
**/*credentials*
**/*credential*
**/*token*
**/*private*
**/.config/github-copilot/
**/.bashrc_custom
**/.zshrc_custom
.env
.env.*
!.env.example
**/.env
**/.env.*
!**/.env.example
**/*.env

# -----------------------------------------------------
# Shell / Fish / ML4W variables
# -----------------------------------------------------
**/fish/fish_variables
**/fish/generated_completions/
**/ml4w/bin/*.sh~      # temporary backups
**/ml4w/listeners/*.sh~
**/ml4w/scripts/*.sh~
**/ml4w/settings/*.sh~
**/ml4w/wallpapers/*.cache
**/ml4w/wallpapers/*.tmp

# -----------------------------------------------------
# Backup / temporary editor files
# -----------------------------------------------------
**/*~
**/*.bak
**/*.backup
**/*.orig
**/*.rej
**/*.swp
**/*.swo
**/*.tmp
**/*.temp
**/.DS_Store
**/Thumbs.db

# -----------------------------------------------------
# IDE / editor configs
# -----------------------------------------------------
**/.vscode/
**/.idea/
**/tags

# -----------------------------------------------------
# SSH / GPG keys
# -----------------------------------------------------
**/.ssh/
**/.ssh/id_*
**/.gnupg/

# -----------------------------------------------------
# System / OS configs
# -----------------------------------------------------
**/.Xresources~
**/.gtkrc-2.0~

# -----------------------------------------------------
# Optional: caches / local runtime files
# -----------------------------------------------------
**/.cache/
**/Cache/
**/cache/
**/.local/state/
**/waypaper/config.ini
